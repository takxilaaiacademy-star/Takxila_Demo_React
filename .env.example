# Copy this file to .env to set things up. Everything here ends up in the browser, so it must be PUBLIC values only.
# NEVER put a client secret, an API secret or a password you use elsewhere in this file.

# Sign-in apps (public client IDs; the defaults are already in src/data/oauth.json). Set only to use a different app.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_MICROSOFT_CLIENT_ID=

# Razorpay key id from dashboard.razorpay.com > Account & Settings > API Keys (rzp_test_... while testing).
VITE_RAZORPAY_KEY_ID=

# Learner emails (order confirmed, enrolled, course completed). Use ONE of these to send the designed HTML email:
#  a) EmailJS (emailjs.com): template body must be {{{html_body}}} (three braces), "To email" {{to_email}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
#  b) Google Apps Script from the academy Gmail: see tools/email/Code.gs, paste the /exec URL here
VITE_MAIL_WEBHOOK=
# With neither set, FormSubmit sends a plain table to the inbox and a plain-text copy to the learner.

# Your live site address, used for the logo and buttons inside emails, e.g. https://takxila.in
VITE_SITE_URL=

# Optional: the password the admin (support@takxila.in) must use on the very first login in a browser.
# Leave empty and the first password typed (8+ characters) becomes the admin password.
VITE_ADMIN_PASSWORD=
