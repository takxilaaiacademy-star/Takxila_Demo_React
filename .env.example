# Copy to .env and fill in your own app IDs (see README, "Social sign-in").
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_MICROSOFT_CLIENT_ID=
# Razorpay key id from dashboard.razorpay.com > Account & Settings > API Keys (rzp_test_... while testing).
VITE_RAZORPAY_KEY_ID=
# Learner emails (purchase, enrolment, course completed) through EmailJS (see README, "Emails to learners").
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Your live site address, used for the logo and buttons inside emails, e.g. https://takxila.in
VITE_SITE_URL=
